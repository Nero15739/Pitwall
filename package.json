{
  "name": "pitwall",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Pit Wall: iRacing league site (PHP, for Hostinger) plus the local replay harvester and push tools",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "push": "node tools/push.ts",
    "harvest": "node tools/harvest.ts",
    "watch": "node tools/watch.ts",
    "compile": "node tools/compile.ts",
    "serve": "php -S 127.0.0.1:8090 -t web web/index.php",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File deploy/package-web.ps1",
    "check": "tsc -p tools",
    "test": "node --test \"tools/test/*.test.ts\"",
    "test:php": "php tests/parity.php"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "koffi": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^6.0.3"
  }
}
