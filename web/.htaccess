# Pit Wall on Hostinger (LiteSpeed) or any Apache-compatible host.

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # pass the API key header through to PHP (some FastCGI setups drop it)
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # private: code, data, settings, CLI tools and dotfiles are never served
  RewriteRule ^(app|storage|bin)(/|$) - [F,L,NC]
  RewriteRule ^config(\.sample)?\.php$ - [F,L,NC]
  RewriteRule (^|/)\. - [F,L]

  # real files (assets) are served directly; everything else goes to the front controller
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  # assets carry a ?v= version stamp, so they can be cached for a year
  <FilesMatch "\.(css|js|svg|woff2|png|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<FilesMatch "^(config(\.sample)?\.php|composer\.(json|lock)|.*\.(sqlite|log|md))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
